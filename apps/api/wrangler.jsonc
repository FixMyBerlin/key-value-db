{
  // Worker name as shown in the Cloudflare dashboard and on workers.dev.
  "name": "key-value-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Placeholder database_id is enough for `wrangler dev`, local D1, and Vitest (Miniflare).
  // Production needs the real uuid from `wrangler d1 create key-value-store --jurisdiction eu`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "key-value-store",
      "database_id": "e0090e7e-ef07-41e3-8baf-e3b4907c52e3",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "OSM_VERIFY_RL",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "vars": {
    "OSM_API_BASE": "https://api.openstreetmap.org",
    "OSM_VERIFY_TTL_S": "3600",
    "ENV": "production",
  },
}
