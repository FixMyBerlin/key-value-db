# Public Vite config for `bun run dev-demo` (committed). Vite inlines every VITE_*
# value into the browser bundle — these are not secrets. GitHub Actions does not
# need them; production uses `.env.production` at `vite build` time.
#
# VITE_KV_BASE_URL: local wrangler (`bun run dev-api`), not GitHub Pages.
# VITE_KV_API_KEY: from creating the `demo` project on *local* D1 (curl/MCP against
#   localhost:8787). Leave REPLACE_ME until then. Local D1 ≠ production D1, so this
#   key is usually different from `.env.production`.
# VITE_OSM_OAUTH_CLIENT_ID: public PKCE client id (same app as production). OSM
#   redirects back to http://127.0.0.1:33477/... after login — not the GitHub URL.
VITE_KV_BASE_URL=http://localhost:8787
VITE_KV_PROJECT=demo
VITE_KV_API_KEY=REPLACE_ME
VITE_OSM_OAUTH_CLIENT_ID=1WcyYxh-sfJPvos-H5X_6OlsANK2IMcRBYtQbI22tsI
